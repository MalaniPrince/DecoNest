<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary"
    tools:context="ui.login.SignUpFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/default_image_size_64dp"
        android:layout_height="@dimen/default_image_size_54dp"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginTop="@dimen/margin_36"
        android:src="@drawable/small_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.AppCompatImageView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/MainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_14"
        android:layout_marginStart="@dimen/margin_42"
        android:layout_marginTop="@dimen/margin_32"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textColor="@color/color_black"
        android:textSize="@dimen/font_44"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatTextView

        android:id="@+id/PersonalizeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_14"

        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/createAccount"
        android:textAlignment="center"
        android:textColor="@color/color_black"
        android:textSize="@dimen/font_40"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/MainTitle">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatTextView

        android:id="@+id/secondText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"

        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/Personalizehome"
        android:textAlignment="center"
        android:textColor="@color/color_black"
        android:textSize="@dimen/font_20"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/PersonalizeText">

    </androidx.appcompat.widget.AppCompatTextView>


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/EnterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginEnd="@dimen/margin_40"
        android:ellipsize="end"

        android:hint="@string/Name"
        android:textColorHint="@color/color_black"
        android:backgroundTint="@color/color_black"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:textColor="@color/color_black"
        app:layout_constraintTop_toBottomOf="@+id/secondText">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/EnterEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginEnd="@dimen/margin_40"
        android:ellipsize="end"
        android:textColorHint="@color/color_black"
        android:backgroundTint="@color/color_black"
        android:hint="@string/Email"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:textColor="@color/color_black"
        app:layout_constraintTop_toBottomOf="@+id/EnterName">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/EnterPassward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginEnd="@dimen/margin_40"
        android:ellipsize="end"
        android:hint="@string/Password"
        android:textColorHint="@color/color_black"
        android:backgroundTint="@color/color_black"
        android:inputType="textPassword"
        android:maxLines="1"
        android:textColor="@color/color_black"
        app:layout_constraintTop_toBottomOf="@+id/EnterEmail">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/EnterComPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginEnd="@dimen/margin_40"
        android:ellipsize="end"
        android:hint="@string/ComPassword"
        android:textColorHint="@color/color_black"
        android:backgroundTint="@color/color_black"
        android:inputType="textPassword"
        android:maxLines="1"
        android:textColor="@color/color_black"
        app:layout_constraintTop_toBottomOf="@+id/EnterPassward">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/SignupButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/font_40"
        android:layout_marginTop="@dimen/margin_20"
        android:layout_marginEnd="@dimen/font_40"
        android:background="@drawable/button_rounded"

        android:text="@string/SignupButton"
        android:textSize="@dimen/font_20"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/EnterComPassword">


    </androidx.appcompat.widget.AppCompatButton>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/SignupButton">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/margin_16"
            android:maxLines="1"
            android:text="@string/already_login"
            android:textAlignment="textStart"
            android:textColor="@color/color_black"
            android:textSize="@dimen/font_16" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/buttonLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_4"
            android:textColor="@color/color_black"
            android:text="@string/LoginButton" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>