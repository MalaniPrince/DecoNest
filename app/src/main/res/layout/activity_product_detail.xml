<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:orientation="vertical">

    <!-- ── HERO IMAGE SECTION ────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_image_size_310dp">

        <!-- Product image -->
        <ImageView
            android:id="@+id/ivProductDetailImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/image1"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Dark gradient overlay at bottom -->
        <View
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:background="@drawable/img_detail_overlay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Back button (top-left) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/margin_42"
            android:layout_height="@dimen/margin_42"
            android:layout_margin="@dimen/margin_14"
            android:background="@drawable/circle_white_bg"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:padding="@dimen/margin_10"
            android:src="@drawable/ic_back"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top-right: Wishlist + Share -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_14"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/margin_42"
                android:layout_height="@dimen/margin_42"
                android:layout_marginEnd="@dimen/margin_8"
                android:background="@drawable/circle_white_bg"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:padding="@dimen/margin_10"
                android:src="@drawable/ic_share"
                android:adjustViewBounds="true" />

            <ImageView
                android:id="@+id/btnWishlist"
                android:layout_width="@dimen/margin_42"
                android:layout_height="@dimen/margin_42"
                android:background="@drawable/circle_white_bg"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:padding="@dimen/margin_10"
                android:src="@drawable/ic_wishlist"
                android:adjustViewBounds="true" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── CONTENT SHEET ─────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-26dp"
        android:background="@drawable/sheet_rounded_top"
        android:elevation="4dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/margin_20"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingBottom="@dimen/margin_16">

            <!-- ── Category chip ── -->
            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_orange_round"
                android:paddingStart="@dimen/margin_12"
                android:paddingEnd="@dimen/margin_12"
                android:paddingTop="@dimen/margin_4"
                android:paddingBottom="@dimen/margin_4"
                android:text="Furniture"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/font_11"
                android:textStyle="bold" />

            <!-- ── Product Name ── -->
            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:text="Product Name"
                android:textColor="#212121"
                android:textSize="@dimen/font_20"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.1" />

            <!-- ── Rating row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/ratingBarDetail"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="4.2"
                    android:progressTint="@color/color_tab_active"
                    android:secondaryProgressTint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvDetailRatingCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_8"
                    android:text="4.2 ★  (128 reviews)"
                    android:textColor="#888888"
                    android:textSize="@dimen/font_12" />

            </LinearLayout>

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#F0F0F0" />

            <!-- ── PRICE SECTION ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- PRICE IN BLACK -->
                <TextView
                    android:id="@+id/tvDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x20b9;0"
                    android:textColor="#212121"
                    android:textSize="@dimen/font_28"
                    android:textStyle="bold" />

                <!-- Discount badge -->
                <TextView
                    android:id="@+id/tvDetailDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_12"
                    android:background="@drawable/bg_btn_orange_round"
                    android:paddingStart="@dimen/margin_10"
                    android:paddingEnd="@dimen/margin_10"
                    android:paddingTop="@dimen/margin_4"
                    android:paddingBottom="@dimen/margin_4"
                    android:text="25% off"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/font_12"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- MRP row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailMrp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M.R.P: &#x20b9;0"
                    android:textColor="#BDBDBD"
                    android:textSize="@dimen/font_12"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDetailSaving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_10"
                    android:text="You save &#x20b9;0"
                    android:textColor="#4CAF50"
                    android:textSize="@dimen/font_12"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Delivery info row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F1F8E9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_delivery" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Free Delivery  •  7-day return"
                    android:textColor="#2E7D32"
                    android:textSize="@dimen/font_12"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#F0F0F0" />

            <!-- ── QUANTITY SELECTOR ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/product_quantity_label"
                    android:textColor="#212121"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_40"
                    android:background="@drawable/qty_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDetailDecrease"
                        android:layout_width="@dimen/margin_42"
                        android:layout_height="@dimen/margin_40"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/color_tab_active"
                        android:textSize="@dimen/font_22"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/tvDetailQty"
                        android:layout_width="@dimen/margin_44"
                        android:layout_height="@dimen/margin_40"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#212121"
                        android:textSize="@dimen/font_15"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/btnDetailIncrease"
                        android:layout_width="@dimen/margin_42"
                        android:layout_height="@dimen/margin_40"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/color_tab_active"
                        android:textSize="@dimen/font_22"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#F0F0F0" />

            <!-- ── DESCRIPTION ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/product_about_title"
                android:textColor="#212121"
                android:textSize="@dimen/font_15"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:lineSpacingMultiplier="1.6"
                android:text="High quality product designed to enhance your home decor."
                android:textColor="#555555"
                android:textSize="@dimen/font_13" />

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="#F0F0F0" />

            <!-- ── REVIEWS SECTION ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reviews &amp; Ratings"
                    android:textColor="#212121"
                    android:textSize="@dimen/font_15"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Write review input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/qty_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/margin_4">

                <EditText
                    android:id="@+id/etReviewText"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_44"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Write your review…"
                    android:paddingStart="@dimen/margin_10"
                    android:textColor="#212121"
                    android:textColorHint="#BDBDBD"
                    android:textSize="@dimen/font_13" />

                <Button
                    android:id="@+id/btnSubmitReview"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_40"
                    android:layout_marginEnd="@dimen/margin_4"
                    android:background="@drawable/bg_btn_orange_round"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:text="Post"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/font_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Bottom padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM ACTION BAR ──────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/margin_14">

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_height="@dimen/default_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_orange_round"
            android:text="@string/btn_add_to_cart"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/font_15"
            android:textStyle="bold" />

        <View
            android:layout_width="@dimen/margin_10"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_height="@dimen/default_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark_round"
            android:text="@string/btn_buy_now"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/font_15"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
