<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOfferBanner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40"
                android:background="@color/color_teal"
                android:text="@string/offer_banner"
                android:textColor="@color/color_white"
                android:textSize="@dimen/font_13"
                android:gravity="center"
                android:elevation="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_white"
                android:orientation="vertical"
                android:elevation="2dp">

                <LinearLayout
                    android:id="@+id/layoutSearch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_48"
                    android:layout_marginStart="@dimen/margin_16"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:layout_marginTop="@dimen/margin_16"
                    android:layout_marginBottom="@dimen/margin_12"
                    android:background="@drawable/search_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16">

                    <ImageView
                        android:layout_width="@dimen/margin_20"
                        android:layout_height="@dimen/margin_20"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="@dimen/margin_12"
                        app:tint="@color/color_gray_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Search Sofas, Beds, Tables..."
                        android:textSize="@dimen/font_14"
                        android:textColor="@color/color_gray_text" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoryTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/margin_48"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/margin_12"
                    android:paddingEnd="@dimen/margin_12"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_image_size_large"
                android:layout_marginTop="@dimen/margin_8"
                android:layout_marginBottom="@dimen/margin_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_white"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:paddingBottom="@dimen/margin_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_20"
                    android:paddingBottom="@dimen/margin_12"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="@dimen/margin_4"
                        android:layout_height="@dimen/margin_20"
                        android:background="@color/color_tab_active"
                        android:layout_marginEnd="@dimen/margin_12" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_shop_by_category"
                        android:textSize="@dimen/font_18"
                        android:textStyle="bold"
                        android:textColor="@color/color_black" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoryGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/margin_8"
                    android:paddingEnd="@dimen/margin_8"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutDefaultSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_white"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:paddingBottom="@dimen/margin_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_trending"
                        android:textSize="@dimen/font_18"
                        android:textStyle="bold"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingTop="@dimen/margin_20"
                        android:paddingBottom="@dimen/margin_12"
                        android:textColor="@color/color_black" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin_8"
                        android:paddingEnd="@dimen/margin_8"
                        android:clipToPadding="false" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_white"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:paddingBottom="@dimen/margin_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_new_arrivals"
                        android:textSize="@dimen/font_18"
                        android:textStyle="bold"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingTop="@dimen/margin_20"
                        android:paddingBottom="@dimen/margin_12"
                        android:textColor="@color/color_black" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin_8"
                        android:paddingEnd="@dimen/margin_8"
                        android:clipToPadding="false" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRecentlyViewed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_white"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingBottom="@dimen/margin_16"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/margin_16"
                        android:paddingEnd="@dimen/margin_16"
                        android:paddingTop="@dimen/margin_20"
                        android:paddingBottom="@dimen/margin_12"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="@dimen/margin_4"
                            android:layout_height="@dimen/margin_20"
                            android:background="#9C27B0"
                            android:layout_marginEnd="@dimen/margin_12" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recently_viewed_title"
                            android:textSize="@dimen/font_18"
                            android:textStyle="bold"
                            android:textColor="@color/color_black" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecentlyViewed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin_8"
                        android:paddingEnd="@dimen/margin_8"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
