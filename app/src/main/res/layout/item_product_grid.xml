<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_4"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_secondary"
    app:cardCornerRadius="@dimen/margin_12"
    app:cardElevation="@dimen/card_elevation_4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/padding_10">

        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_image_size_160dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivGridProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                tools:src="@drawable/placeholder_image" />

            <TextView
                android:id="@+id/tvGridDiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/bg_gradient_accent"
                android:paddingStart="@dimen/margin_6"
                android:paddingEnd="@dimen/margin_6"
                android:paddingTop="@dimen/margin_2"
                android:paddingBottom="@dimen/margin_2"
                android:textColor="@color/color_white"
                android:textSize="@dimen/font_10"
                android:textStyle="bold"
                tools:text="25% OFF" />

            <TextView
                android:id="@+id/tvGridBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/bg_gradient_button"
                android:paddingStart="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_8"
                android:paddingTop="@dimen/margin_2"
                android:paddingBottom="@dimen/margin_2"
                android:textColor="@color/color_white"
                android:textSize="@dimen/font_10"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="HOT"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/btnGridWishlist"
                android:layout_width="@dimen/default_button_size_small"
                android:layout_height="@dimen/default_button_size_small"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/circle_bg"
                android:padding="@dimen/margin_6"
                android:src="@drawable/ic_wishlist"
                app:tint="@color/color_white" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvGridProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_10"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginEnd="@dimen/margin_10"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/font_13"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageContainer"
            tools:text="Modern Sofa" />

        <TextView
            android:id="@+id/tvGridProductCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/font_11"
            app:layout_constraintEnd_toEndOf="@id/tvGridProductName"
            app:layout_constraintStart_toStartOf="@id/tvGridProductName"
            app:layout_constraintTop_toBottomOf="@id/tvGridProductName"
            tools:text="Furniture" />

        <RatingBar
            android:id="@+id/ratingBarGridProduct"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:numStars="5"
            android:stepSize="0.1"
            app:layout_constraintStart_toStartOf="@id/tvGridProductName"
            app:layout_constraintTop_toBottomOf="@id/tvGridProductCategory"
            tools:rating="4.2" />

        <TextView
            android:id="@+id/tvGridProductMrp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:textColor="@color/color_tab_inactive"
            android:textSize="@dimen/font_11"
            app:layout_constraintStart_toStartOf="@id/tvGridProductName"
            app:layout_constraintTop_toBottomOf="@id/ratingBarGridProduct"
            tools:text="₹ 16,999" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tvGridProductName"
            app:layout_constraintStart_toStartOf="@id/tvGridProductName"
            app:layout_constraintTop_toBottomOf="@id/tvGridProductMrp">

            <TextView
                android:id="@+id/tvGridProductPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_tab_active"
                android:textSize="@dimen/font_14"
                android:textStyle="bold"
                tools:text="₹ 12,999" />

            <ImageView
                android:id="@+id/btnGridAddToCart"
                android:layout_width="@dimen/default_button_size_small"
                android:layout_height="@dimen/default_button_size_small"
                android:background="@drawable/bg_gradient_accent"
                android:padding="@dimen/margin_6"
                android:src="@drawable/ic_nav_cart"
                app:tint="@color/color_white" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
