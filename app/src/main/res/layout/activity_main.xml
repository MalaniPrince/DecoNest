<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── MAIN CONTENT ─────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_white">

        <!-- Toolbar -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="@dimen/default_view_height"
            android:background="@color/color_white"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_4"
            android:paddingEnd="@dimen/margin_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="@dimen/margin_48"
                android:layout_height="@dimen/margin_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="@dimen/margin_12"
                android:src="@drawable/ic_menu"
                android:adjustViewBounds="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/deconest"
                android:textColor="@color/color_dark_gray"
                android:textSize="@dimen/font_20"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/margin_44"
                android:layout_height="@dimen/margin_44"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/margin_10"
                android:src="@drawable/ic_search"
                android:adjustViewBounds="true"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/imgCart"
                android:layout_width="@dimen/margin_44"
                android:layout_height="@dimen/margin_44"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="@dimen/margin_10"
                android:src="@drawable/cart"
                android:adjustViewBounds="true" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_time_slot_height"
            android:background="@drawable/bottom_nav_bg"
            android:elevation="20dp"
            app:itemBackground="@drawable/nav_item_bg_selector"
            app:itemIconSize="26dp"
            app:itemIconTint="@color/bottom_nav_selector"
            app:itemTextColor="@color/bottom_nav_selector"
            app:itemTextAppearanceActive="@style/BottomNavTextActive"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── NAVIGATION DRAWER ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FAFAFA"
        android:elevation="12dp"
        android:orientation="vertical">

        <!-- HEADER: Gradient with profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/drawer_header_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_20"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_40"
            android:paddingBottom="0dp">

            <!-- Close button row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="@dimen/margin_14">

                <ImageView
                    android:id="@+id/ivDrawerClose"
                    android:layout_width="@dimen/default_button_size_medium"
                    android:layout_height="@dimen/default_button_size_medium"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/margin_6"
                    android:src="@drawable/ic_close"
                    android:tint="#FFFFFF"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <!-- Profile row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDrawerInitial"
                    android:layout_width="@dimen/margin_72"
                    android:layout_height="@dimen/margin_72"
                    android:background="@drawable/circle_bg"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="@color/color_white"
                    android:textSize="@dimen/font_24"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margin_14">

                    <TextView
                        android:id="@+id/tvDrawerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/priyanshu"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/font_18"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_3"
                        android:text="user@gmail.com"
                        android:textColor="#FFE4C8"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_18"
                android:layout_marginBottom="0dp"
                android:background="#20000000"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/statOrders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_10"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvDrawerOrderCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/font_17"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orders"
                        android:textColor="#FFE4C8"
                        android:textSize="@dimen/font_11" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="#40FFFFFF" />

                <LinearLayout
                    android:id="@+id/statWishlist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_10"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvDrawerWishlistCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/font_17"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wishlist"
                        android:textColor="#FFE4C8"
                        android:textSize="@dimen/font_11" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="#40FFFFFF" />

                <LinearLayout
                    android:id="@+id/statWallet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_10"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvDrawerWalletBal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x20b9;0"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/font_17"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet"
                        android:textColor="#FFE4C8"
                        android:textSize="@dimen/font_11" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- SCROLLABLE MENU -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section: SHOPPING -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_16"
                    android:paddingBottom="@dimen/margin_4"
                    android:text="SHOPPING"
                    android:textColor="@color/color_gray_text"
                    android:textSize="@dimen/font_10"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <!-- My Cart -->
                <LinearLayout
                    android:id="@+id/menuMyCart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_nav_cart"
                        android:tint="@color/color_tab_active"
                        android:adjustViewBounds="true" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Cart"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- Browse Categories -->
                <LinearLayout
                    android:id="@+id/menuBrowseCategories"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/img_category" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Browse Categories"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <!-- Section: MY ACCOUNT -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@color/color_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_4"
                    android:text="MY ACCOUNT"
                    android:textColor="@color/color_gray_text"
                    android:textSize="@dimen/font_10"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <!-- My Orders -->
                <LinearLayout
                    android:id="@+id/menuTrackOrder"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_orders" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Orders"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- My Wallet -->
                <LinearLayout
                    android:id="@+id/menuWallet"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_wallet" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Wallet"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- Address Book -->
                <LinearLayout
                    android:id="@+id/menuAddress"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_address" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Address Book"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- Wishlist -->
                <LinearLayout
                    android:id="@+id/menuWishlist"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_wishlist" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wishlist"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- Recently Viewed -->
                <LinearLayout
                    android:id="@+id/menuRecentlyViewed"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_recent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recently Viewed"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- My Reviews -->
                <LinearLayout
                    android:id="@+id/menuReviews"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_review" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Reviews"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <!-- Section: SUPPORT -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@color/color_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_4"
                    android:text="SUPPORT"
                    android:textColor="@color/color_gray_text"
                    android:textSize="@dimen/font_10"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <!-- Privacy Policy -->
                <LinearLayout
                    android:id="@+id/menuPrivacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_privacy" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Privacy Policy"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- Help Center -->
                <LinearLayout
                    android:id="@+id/menuHelpCenter"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_help" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Help Center"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="52dp" />

                <!-- About DecoNest -->
                <LinearLayout
                    android:id="@+id/menuAboutDecoNest"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/padding_22"
                        android:layout_height="@dimen/padding_22"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:src="@drawable/ic_info_circle" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="About DecoNest"
                        android:textColor="@color/color_dark_gray"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="@dimen/margin_18"
                        android:layout_height="@dimen/margin_18"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@color/color_divider" />

            </LinearLayout>

        </ScrollView>

        <!-- FOOTER: Logout + Version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider" />

            <TextView
                android:id="@+id/tvDrawerLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/logout"
                android:textColor="#E53935"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingBottom="8dp"
                android:text="@string/app_version_1_0_0"
                android:textColor="@color/color_gray_text"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
