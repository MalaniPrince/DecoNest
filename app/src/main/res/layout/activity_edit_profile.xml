<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <LinearLayout
        android:id="@+id/headerEditProfile"
        android:layout_width="0dp"
        android:layout_height="@dimen/default_view_height"
        android:background="@color/color_white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margin_4"
        android:paddingEnd="@dimen/margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnEditProfileBack"
            android:layout_width="@dimen/margin_48"
            android:layout_height="@dimen/margin_48"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/margin_12"
            android:src="@drawable/ic_back"
            android:adjustViewBounds="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Profile"
            android:textColor="@color/color_dark_gray"
            android:textSize="@dimen/font_18"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerEditProfile">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_24">

                <TextView
                    android:layout_width="@dimen/margin_88"
                    android:layout_height="@dimen/margin_88"
                    android:background="@drawable/circle_bg"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="@color/color_white"
                    android:textSize="@dimen/font_36"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="@dimen/font_12"
                android:textColor="@color/color_gray_text"
                android:layout_marginBottom="@dimen/margin_4" />

            <TextView
                android:id="@+id/tvEditEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button"
                android:background="@color/color_divider"
                android:paddingStart="@dimen/margin_12"
                android:paddingEnd="@dimen/margin_12"
                android:gravity="center_vertical"
                android:textSize="@dimen/font_14"
                android:textColor="@color/color_gray_text"
                android:layout_marginBottom="@dimen/margin_16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="12sp"
                android:textColor="@color/color_gray_text"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEditName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_52"
                android:background="@color/color_white"
                android:inputType="textPersonName"
                android:hint="Enter your name"
                android:paddingStart="@dimen/margin_12"
                android:paddingEnd="@dimen/margin_12"
                android:textSize="@dimen/font_15"
                android:textColor="@color/color_text_primary"
                android:layout_marginBottom="@dimen/margin_16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="12sp"
                android:textColor="@color/color_gray_text"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEditPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_52"
                android:background="@color/color_white"
                android:inputType="phone"
                android:hint="Enter phone number"
                android:paddingStart="@dimen/margin_12"
                android:paddingEnd="@dimen/margin_12"
                android:textSize="@dimen/font_15"
                android:textColor="@color/color_text_primary"
                android:layout_marginBottom="@dimen/margin_28" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_52"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textSize="@dimen/font_16"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:background="@drawable/button_rounded" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
