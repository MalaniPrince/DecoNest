<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary"

    tools:context=".ui.login.LoginFragment">



    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/TopTitle"
        android:text="@string/WelcomeBack"
        android:textSize="@dimen/font_44"
        android:textStyle="bold"
        android:textColor="@color/color_black"
        android:textAlignment="center"
        android:layout_marginTop="@dimen/margin_32"
        app:layout_constraintTop_toTopOf="parent">
    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatTextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/Secondtitle"
        app:layout_constraintTop_toBottomOf="@+id/TopTitle"

        android:layout_marginTop="@dimen/margin_14"
        android:text="@string/CountinueDesinging"
        android:textColor="@color/color_black"
        android:textStyle=""
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/font_20"
        android:textAlignment="center">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sofaImage"
        android:layout_width="@dimen/default_image_size_409dp"
        android:layout_height="@dimen/default_image_size_262dp"
        android:scaleType="centerCrop"
        android:src="@drawable/onboardinglogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Secondtitle"
        android:layout_marginTop="@dimen/margin_24">

    </androidx.appcompat.widget.AppCompatImageView>



    <androidx.appcompat.widget.AppCompatEditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/InputEmail"
        android:textColor="@color/color_black"
        android:hint="@string/Email"
        android:textColorHint="@color/color_black"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginEnd="@dimen/margin_40"
        app:layout_constraintTop_toBottomOf="@+id/sofaImage"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/margin_24">

    </androidx.appcompat.widget.AppCompatEditText>
    <androidx.appcompat.widget.AppCompatEditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/InputPassward"

        android:hint="@string/Password"
        android:textColor="@color/color_black"
        android:textColorHint="@color/color_black"
        android:layout_marginStart="@dimen/margin_40"
        android:layout_marginEnd="@dimen/margin_40"
        app:layout_constraintTop_toBottomOf="@+id/InputEmail"
        android:inputType="textPassword"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/margin_20">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/LoginButton"
        android:text="@string/LoginButton"
        android:background="@drawable/button_rounded"
        android:textStyle="bold"
        android:textSize="@dimen/font_20"
        android:layout_marginTop="@dimen/margin_48"
        android:layout_marginStart="@dimen/font_40"
        android:layout_marginEnd="@dimen/font_40"
        app:layout_constraintTop_toBottomOf="@+id/InputPassward">

    </androidx.appcompat.widget.AppCompatButton>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/CreateAccount"
        android:text="@string/createsign"
        android:layout_marginTop="@dimen/margin_14"
        android:textSize="@dimen/font_16"
        android:textAlignment="center"
        android:textColor="@color/color_black"
        android:layout_marginHorizontal="120dp"
        app:layout_constraintTop_toBottomOf="@+id/LoginButton">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/Sign_up_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_14"
        android:text="@string/Sign_up"
        android:textSize="@dimen/font_16"
        app:layout_constraintStart_toEndOf="@+id/CreateAccount"
        app:layout_constraintTop_toBottomOf="@+id/LoginButton" />


</androidx.constraintlayout.widget.ConstraintLayout>