<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/product_card_width"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_8"
    app:cardCornerRadius="@dimen/margin_16"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_image_size_160dp">

            <ImageView
                android:id="@+id/ivProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/image1"
                android:adjustViewBounds="true" />

            <!-- Discount badge (top-left) -->
            <TextView
                android:id="@+id/tvDiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_8"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_gradient_accent"
                android:paddingStart="@dimen/margin_7"
                android:paddingEnd="@dimen/margin_7"
                android:paddingTop="@dimen/margin_3"
                android:paddingBottom="@dimen/margin_3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/font_10"
                android:textStyle="bold"
                android:text="25% OFF"
                android:visibility="visible" />

            <!-- Wishlist heart button (top-right) -->
            <ImageView
                android:id="@+id/btnCardWishlist"
                android:layout_width="@dimen/default_button_size_medium"
                android:layout_height="@dimen/default_button_size_medium"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/circle_bg"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/margin_8"
                android:src="@drawable/ic_wishlist"
                android:adjustViewBounds="true" />

            <!-- "New" / "Hot" label badge (bottom-left) -->
            <TextView
                android:id="@+id/tvProductBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/bg_gradient_button"
                android:paddingStart="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_8"
                android:paddingTop="@dimen/margin_3"
                android:paddingBottom="@dimen/margin_3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/font_10"
                android:textStyle="bold"
                android:text="HOT"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_10">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="@dimen/font_13"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Furniture"
                android:textSize="@dimen/font_11"
                android:textColor="#9E9E9E"
                android:layout_marginTop="@dimen/margin_2" />

            <RatingBar
                android:id="@+id/ratingBarProduct"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:isIndicator="true"
                android:numStars="5"
                android:rating="4.0"
                android:progressTint="@color/color_tab_active"
                android:secondaryProgressTint="@color/color_divider" />

            <!-- MRP crossed out -->
            <TextView
                android:id="@+id/tvProductMrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹16,999"
                android:textSize="@dimen/font_11"
                android:textColor="#BDBDBD"
                android:layout_marginTop="@dimen/margin_3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹12,999"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold"
                    android:textColor="#E67E22" />

                <ImageView
                    android:id="@+id/btnCardAddToCart"
                    android:layout_width="@dimen/default_button_size_small"
                    android:layout_height="@dimen/default_button_size_small"
                    android:background="@drawable/bg_gradient_accent"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/margin_6"
                    android:src="@drawable/ic_nav_cart"
                    android:tint="@color/color_white"
                    android:adjustViewBounds="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
