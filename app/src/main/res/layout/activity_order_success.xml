<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient_background"
    android:padding="@dimen/margin_24">

    <ImageView
        android:id="@+id/ivSuccessIcon"
        android:layout_width="@dimen/margin_120"
        android:layout_height="@dimen/margin_120"
        android:src="@drawable/ic_orders"
        app:tint="@color/color_tab_active"
        android:adjustViewBounds="true" />

    <TextView
        android:id="@+id/tvOrderSuccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Placed Successfully!"
        android:textSize="@dimen/font_22"
        android:textStyle="bold"
        android:textColor="@color/color_dark_gray"
        android:layout_marginTop="@dimen/margin_24"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvOrderSuccessSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your order has been confirmed. You will receive an email confirmation shortly."
        android:textSize="@dimen/font_14"
        android:textColor="@color/color_gray_text"
        android:layout_marginTop="@dimen/margin_8"
        android:gravity="center" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_32"
        app:cardCornerRadius="@dimen/margin_12"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_16">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order ID"
                    android:textSize="@dimen/font_13" />
                <TextView
                    android:id="@+id/tvSuccessOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="#DN-10293"
                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount Paid"
                    android:textSize="@dimen/font_13" />
                <TextView
                    android:id="@+id/tvSuccessAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="₹12,499"
                    android:textStyle="bold"
                    android:textColor="@color/color_tab_active" />
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnContinueShopping"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_52"
        android:layout_marginTop="@dimen/margin_40"
        android:text="Continue Shopping"
        android:background="@drawable/bg_gradient_button"
        android:textColor="@color/color_white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnViewOrders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View My Orders"
        android:textColor="@color/color_tab_active"
        android:textSize="@dimen/font_14"
        android:layout_marginTop="@dimen/margin_16"
        android:padding="@dimen/margin_8" />

</LinearLayout>
