<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_16"
    android:layout_marginEnd="@dimen/margin_16"
    android:layout_marginBottom="@dimen/margin_12"
    app:cardCornerRadius="@dimen/margin_14"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/margin_12">

        
        <ImageView
            android:id="@+id/ivCartProduct"
            android:layout_width="@dimen/margin_90"
            android:layout_height="@dimen/margin_90"
            android:scaleType="centerCrop"
            android:src="@drawable/image1"
            android:adjustViewBounds="true" />

        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_12">

            <TextView
                android:id="@+id/tvCartProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modern Sofa"
                android:textSize="@dimen/font_14"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCartProductCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Furniture"
                android:textSize="@dimen/font_12"
                android:textColor="#9E9E9E"
                android:layout_marginTop="@dimen/margin_3" />

            <TextView
                android:id="@+id/tvCartProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹32,999"
                android:textSize="@dimen/font_15"
                android:textStyle="bold"
                android:textColor="#E67E22"
                android:layout_marginTop="@dimen/margin_6" />

            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/qty_bg">

                <TextView
                    android:id="@+id/btnDecrease"
                    android:layout_width="@dimen/margin_32"
                    android:layout_height="@dimen/margin_32"
                    android:text="-"
                    android:textSize="@dimen/font_18"
                    android:textStyle="bold"
                    android:textColor="#E67E22"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="@dimen/margin_32"
                    android:layout_height="@dimen/margin_32"
                    android:text="1"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnIncrease"
                    android:layout_width="@dimen/margin_32"
                    android:layout_height="@dimen/margin_32"
                    android:text="+"
                    android:textSize="@dimen/font_18"
                    android:textStyle="bold"
                    android:textColor="#E67E22"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

        
        <ImageView
            android:id="@+id/btnRemoveCart"
            android:layout_width="@dimen/margin_24"
            android:layout_height="@dimen/margin_24"
            android:src="@drawable/ic_close"
            android:alpha="0.5"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="top"
            android:adjustViewBounds="true" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
